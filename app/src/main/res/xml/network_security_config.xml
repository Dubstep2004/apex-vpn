<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 9+ запрещает обычный HTTP. Приложению он нужен только для своего ядра на этом же
  телефоне (API ядра на 127.0.0.1: пинг через сервер, автопилот, трафик приложений).
  Всё остальное — только HTTPS, как и раньше.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
