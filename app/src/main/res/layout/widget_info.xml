<?xml version="1.0" encoding="utf-8"?>
<!-- 10. Информационный виджет: сервер, скорость, пинг и кнопка -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/info_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/info_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Выключен"
                android:textColor="#F4F4F7"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/info_server"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Автопилот"
                android:textColor="#8E8E9A"
                android:textSize="13sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/info_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="Включить или выключить VPN"
            android:src="@drawable/widget_power_off" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:gravity="bottom"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Скорость"
                android:textColor="#8E8E9A"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/info_down"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="↓ —"
                android:textColor="#5BD69A"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/info_up"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="↑ —"
                android:textColor="#B9B2FF"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Пинг"
                android:textColor="#8E8E9A"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/info_ping"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="—"
                android:textColor="#F4F4F7"
                android:textSize="24sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
