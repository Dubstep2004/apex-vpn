<?xml version="1.0" encoding="utf-8"?>
<!-- 44. Виджет 4×2: кнопка VPN и выбор из четырёх серверов -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/srv_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="11dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingBottom="4dp">

        <LinearLayout
            android:id="@+id/srv_header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/srv_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Выключен"
                android:textColor="#F4F4F7"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/srv_ping"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="APEX VPN"
                android:textColor="#8E8E9A"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/srv_button"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="Включить или выключить VPN"
            android:src="@drawable/widget_power_off" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/srv_0"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="3dp"
            android:background="@drawable/widget_cell"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxLines="2"
            android:paddingStart="10dp"
            android:paddingEnd="8dp"
            android:text="—"
            android:textColor="#F4F4F7"
            android:textSize="13sp" />
        <TextView
            android:id="@+id/srv_1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="3dp"
            android:background="@drawable/widget_cell"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxLines="2"
            android:paddingStart="10dp"
            android:paddingEnd="8dp"
            android:text="—"
            android:textColor="#F4F4F7"
            android:textSize="13sp" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/srv_2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="3dp"
            android:background="@drawable/widget_cell"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxLines="2"
            android:paddingStart="10dp"
            android:paddingEnd="8dp"
            android:text="—"
            android:textColor="#F4F4F7"
            android:textSize="13sp" />
        <TextView
            android:id="@+id/srv_3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="3dp"
            android:background="@drawable/widget_cell"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxLines="2"
            android:paddingStart="10dp"
            android:paddingEnd="8dp"
            android:text="—"
            android:textColor="#F4F4F7"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
